# Dependencies
/node_modules
/.pnp
.pnp.js

# Production build output
/.next/
/out/

# Environment variables — NEVER commit these
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug / scratch files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build cache
tsconfig.tsbuildinfo

# Local workspace artifacts
/Microsoft/Windows/PowerShell/ModuleAnalysisCache
/prisma/schema111.prisma

# OS generated files
.DS_Store
Thumbs.db

# Upload storage (local dev only — use cloud storage in production)
/public/uploads/*
!/public/uploads/.gitkeep

# Zip archives (dev artifacts)
*.zip

# Scratch / test scripts at root (dev only)
scratch-*.ts
test-*.ts
