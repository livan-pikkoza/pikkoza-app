# # Copy to .env and set values in your private environment. Never commit .env.

# # PostgreSQL
# DATABASE_URL="<YOUR_DATABASE_URL>"


# # Pikkoza authentication
# JWT_SECRET="replace-with-a-long-random-secret"

# # Google Calendar / Meet OAuth (server-only)
# GOOGLE_OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# GOOGLE_OAUTH_REDIRECT_URI="https://your-domain.example/api/admin/google-oauth/callback"
# GOOGLE_ORGANIZER_EMAIL="organizer@example.com"
# # Generate with: openssl rand -base64 32
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
# # Calendar ID owned by the authorized organizer account; use primary if appropriate.
# GOOGLE_CALENDAR_ID="your-calendar-id-or-primary"

# # Legacy service-account credentials retained until OAuth Meet is verified.
# # These are no longer used by booking requests.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="<YOUR_GOOGLE_SERVICE_ACCOUNT_EMAIL>"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="replace-with-service-account-private-key"

# # LiveKit (retained)
# LIVEKIT_URL="wss://your-livekit-host.example"
# LIVEKIT_API_KEY="replace-with-livekit-api-key"
# LIVEKIT_API_SECRET="replace-with-livekit-api-secret"

# # Firebase Web Client SDK

# NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
# NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"

# # Runtime
# NODE_ENV="development"



# Copy to .env and set values in your private environment. Never commit .env.

# PostgreSQL
DATABASE_URL="<YOUR_DATABASE_URL>"


# Pikkoza authentication
JWT_SECRET="replace-with-a-long-random-secret"

# Google Calendar / Meet OAuth (server-only)
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://your-domain.example/api/admin/google-oauth/callback"
GOOGLE_ORGANIZER_EMAIL="organizer@example.com"
# Generate with: openssl rand -base64 32
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
# Calendar ID owned by the authorized organizer account; use primary if appropriate.
GOOGLE_CALENDAR_ID="your-calendar-id-or-primary"

# Legacy service-account credentials retained until OAuth Meet is verified.
# These are no longer used by booking requests.
GOOGLE_SERVICE_ACCOUNT_EMAIL="<YOUR_GOOGLE_SERVICE_ACCOUNT_EMAIL>"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="replace-with-service-account-private-key"
# LiveKit (retained)

LIVEKIT_URL="wss://your-livekit-host.example"
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"

# Firebase Web Client SDK

Firebase Admin SDK (server only).
For local Windows development, configure both service-account fields below instead of relying on Application Default Credentials.
FIREBASE_ADMIN_PROJECT_ID takes precedence over NEXT_PUBLIC_FIREBASE_PROJECT_ID; if both are set, they must match.
Firebase Console: Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID="your-firebase-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="your-firebase-admin-service-account@example.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="replace-with-firebase-admin-service-account-private-key"

NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"


# Runtime
NODE_ENV="development"
