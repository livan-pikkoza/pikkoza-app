datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  REQUESTED
  UPCOMING
  COMPLETED
  CANCELLED
  REJECTED
}

enum DoubtStatus {
  OPEN
  ACCEPTED
  REJECTED
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  phone              String?
  avatar             String?
  firebaseUid        String?             @unique
  role               Role                @default(STUDENT)
  status             UserStatus          @default(ACTIVE)
  verificationStatus VerificationStatus? @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  profile            Profile?
  tutorProfile       TutorProfile?
  studentSessions    Session[]           @relation("StudentSessions")
  tutorSessions      Session[]           @relation("TutorSessions")
  reviewsGiven       Review[]            @relation("StudentReviews")
  reviewsReceived    Review[]            @relation("TutorReviews")
  studentDoubts      Doubt[]             @relation("StudentDoubts")
  tutorDoubts        Doubt[]             @relation("TutorDoubts")

  notifications      Notification[]      @relation("UserNotifications")
  studentConversations Conversation[]    @relation("StudentConversations")
  tutorConversations   Conversation[]    @relation("TutorConversations")
  sentMessages         Message[]         @relation("SentMessages")
}

model ApiRateLimitBucket {
  key        String
  windowStart DateTime
  count      Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade              String?  @default("Class 12")
  stream             String?  @default("PCM")
  targetExam         String?  @default("JEE Main & Advanced")
  interestedSubjects String[] @default(["Physics", "Mathematics"])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TutorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?            @default("Expert educator helping students clear PCM/PCB doubts.")
  institute          String?            @default("IIT Bombay")
  qualifications     String?            @default("B.Tech Electrical, IIT Bombay")
  experienceYears    Int                @default(5)
  hourlyRate         Int                @default(199)
  verificationStatus VerificationStatus @default(PENDING)
  isAvailableNow     Boolean            @default(true)
  teachingSubjects   String[]           @default(["Physics", "Mathematics"])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  availabilitySlots  AvailabilitySlot[]
}

model AvailabilitySlot {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  day            String
  startTime      String
  endTime        String
  createdAt      DateTime     @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation("StudentSessions", fields: [studentId], references: [id])
  tutorId         String
  tutor           User          @relation("TutorSessions", fields: [tutorId], references: [id])
  subject         String
  date            String
  time            String
  durationMinutes Int           @default(30)
  price           Int           @default(199)
  meetUrl         String
  status          SessionStatus @default(REQUESTED)
  rating          Int?
  reviewText      String?
  notes           String?
  resources       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reviews         Review[]

  @@index([studentId])
  @@index([tutorId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentReviews", fields: [studentId], references: [id])
  tutorId   String
  tutor     User     @relation("TutorReviews", fields: [tutorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Doubt {
  id         String      @id @default(cuid())
  studentId  String
  student    User        @relation("StudentDoubts", fields: [studentId], references: [id])
  tutorId    String?
  tutor      User?       @relation("TutorDoubts", fields: [tutorId], references: [id])
  subject    String
  content    String?
  imageUrl   String?
  status     DoubtStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([studentId])
  @@index([tutorId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  sessionId String?  @unique
  doubtId   String?  @unique
  studentId String
  student   User     @relation("StudentConversations", fields: [studentId], references: [id])
  tutorId   String
  tutor     User     @relation("TutorConversations", fields: [tutorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, read])
}

model GoogleOAuthCredential {
  id                      String   @id @default("organizer")
  encryptedRefreshToken   String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
